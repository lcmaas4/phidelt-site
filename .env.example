# ==============================================================================
# Environment Configuration Template
# Duplicate this file as .env.local for local development.
# ==============================================================================

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/phidelt?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Media Configuration (from Cloudinary Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing Portal Credentials
NOTION_PASSWORD=
NOTION_LINK=
